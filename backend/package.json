{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "A Strapi application",
  "scripts": {
    "build": "strapi build",
    "console": "strapi console",
    "deploy": "strapi deploy",
    "dev": "strapi develop",
    "develop": "strapi develop",
    "start": "strapi start",
    "strapi": "strapi",
    "seed:demo": "npm run build && node scripts/seed-demo.js",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "jest --runInBand tests/unit",
    "test:api": "npm run build && jest --runInBand --forceExit --detectOpenHandles tests/api",
    "upgrade": "npx @strapi/upgrade latest",
    "upgrade:dry": "npx @strapi/upgrade latest --dry"
  },
  "dependencies": {
    "@strapi/database": "5.52.1",
    "@strapi/plugin-cloud": "5.52.1",
    "@strapi/plugin-users-permissions": "5.52.1",
    "@strapi/strapi": "5.52.1",
    "pg": "8.20.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.30.3",
    "styled-components": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "sqlite3": "^6.0.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.0.0 <=26.x.x",
    "npm": ">=6.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": "<rootDir>/tests/jest-transformer.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/build/",
      "/.tmp/",
      "/.cache/"
    ]
  },
  "strapi": {
    "uuid": "5969129b-8e94-4752-af6d-d0935e197ec1",
    "installId": "ec8868270e8de41c2de3e4c888bddd88e6d625b67ced68b6d310af97948f0985"
  }
}
