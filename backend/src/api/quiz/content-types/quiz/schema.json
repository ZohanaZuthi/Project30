{
  "kind": "collectionType",
  "collectionName": "quizzes",
  "info": {
    "singularName": "quiz",
    "pluralName": "quizzes",
    "displayName": "Quiz",
    "description": "A server-graded MCQ quiz belonging to a course"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "minLength": 2,
      "maxLength": 180
    },
    "position": {
      "type": "integer",
      "required": true,
      "min": 1,
      "default": 1
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "inversedBy": "quizzes",
      "required": true
    },
    "questions": {
      "type": "component",
      "repeatable": true,
      "component": "quiz.question",
      "required": true
    },
    "attempts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::quiz-attempt.quiz-attempt",
      "mappedBy": "quiz"
    }
  }
}
