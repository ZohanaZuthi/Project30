{
  "kind": "collectionType",
  "collectionName": "lessons",
  "info": {
    "singularName": "lesson",
    "pluralName": "lessons",
    "displayName": "Lesson",
    "description": "An ordered text or video lesson within a course"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "minLength": 2,
      "maxLength": 180
    },
    "content": {
      "type": "richtext"
    },
    "videoUrl": {
      "type": "string"
    },
    "position": {
      "type": "integer",
      "required": true,
      "min": 1,
      "default": 1
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "inversedBy": "lessons",
      "required": true
    },
    "progressRecords": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::lesson-progress.lesson-progress",
      "mappedBy": "lesson"
    }
  }
}
